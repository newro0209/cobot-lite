// cobot-lite 전역 파라미터 (global parameters) — v0.17 팔레타이저식 하부 구동
// 모든 부품 치수는 이 파일에서만 정의한다 — 매직 넘버 하드코딩 금지 (MEC-008)
//
// v0.17 아키텍처: J1~J3 모터 전부 베이스측 고정 구조물에 장착 (이동부 모터 0).
//   J1 = 베이스 하부 수직 직결 (터릿 6810ZZ 슬루 + ⌀8 축 클램프 허브)
//   J2 = -Y 타워 직결 → J2 허브 → 상완 -Y 측판
//   J3 = +Y 타워에 J2 동축 장착 → 크랭크 → 구동 링크 → 팔꿈치 혼 → 하완
//       (평행사변형: 크랭크 월드각 = 하완 월드 피치, 1:1 원격 전달)
// 링크 꺾임(팔레타이저 오프셋): 상완 10°/하완 18° — 현(chord) 일직선(접힘각 0°,
//   특이점)에 도달하기 전에 소프트 리미트(env_fold_max)로 차단.

/* ===== 출력/렌더링 ===== */
$fn = 64;

/* ===== 공통 가공 여유 (파생 치수에서 참조 — 선행 정의 필수) ===== */
clearance_fit = 0.3;      // 회전/슬라이드 끼움 여유
bolt_hole_oversize = 0.4; // 관통 볼트 홀 여유
washer_t = 1.2;           // 평와셔 표준 두께 (스택 산정용)

/* ===== 베어링 (bearing) — CON-002 허용 4종 전부 사용 =====
   [내경, 외경, 폭] mm */
BRG_608ZZ  = [8,  22, 7];   // 팔꿈치 피벗 ×2 (상완 측판 압입, ⌀8 숄더 볼트)
BRG_625ZZ  = [5,  16, 5];   // 구동 링크 양단 ×2 (⌀5 숄더 볼트 핀)
BRG_6805ZZ = [25, 37, 7];   // J2 측판 지지 ×2 (허브/크랭크 보스 ⌀25 위)
BRG_6810ZZ = [50, 65, 7];   // J1 슬루 ×1 (터릿 압입, 베이스 링 보스 위)

// 베어링 압입 공차 (press-fit tolerance) — MFG-002
// 외경 기준 -0.1 ~ -0.2mm. 프린터별 보정은 이 변수 하나로 조정한다.
bearing_press_fit = -0.15;

/* ===== 숄더 볼트 (stripper/shoulder bolt) — CON-001 ===== */
shoulder_d_large = 8;   // 608ZZ 결합 — 팔꿈치 피벗 ⌀8×25 ×2
shoulder_d_small = 5;   // 625ZZ 결합 — 크랭크 핀 ⌀5×16 / 혼 핀 ⌀5×25 [와셔 조정]

/* ===== 링크 길이 — MEC-006 (유산값 유지) =====
   L1/L2는 관절축 사이 '현(chord)' 거리 — 빔 꺾임과 무관하게 기구학 기준 */
L1 = 225;   // 상완 현: J2 축 → 팔꿈치 축 (= 구동 링크 핀 간 거리)
L2 = 275;   // 하완 현: 팔꿈치 축 → 공구 기준점 (유산)

/* ===== 링크 꺾임 (팔레타이저식 기구학 오프셋) =====
   꺾임 무릎(knee)은 현 위쪽(+z, 링크 코리도 반대면은 스탠드오프 벨트).
   무릎 높이 ≈ pos·(1-pos)·L·tan(bend) — lib/utils.scad knee_h() 참조.
   목적: ① 현 일직선(접힘각 0° = 특이점) 도달 전 빔 한계 + 소프트 리미트
        ② 저자세(낮은 작업점)에서 팔꿈치의 본체 후방 돌출 억제 (하완 꺾임) */
ua_bend_deg = 15;     // 상완 꺾임각 (knee_h ≈ 14.9)
ua_bend_pos = 0.55;   // 꺾임 위치 (0~1, J2 기준)
fa_bend_deg = 30;     // 하완 꺾임각 (knee_h ≈ 32.2 — 공격적 도그레그)
fa_bend_pos = 0.25;   // 꺾임 위치 (팔꿈치 기준)

/* ===== 가동 엔벨로프 (소프트 리미트 권고값) =====
   접힘각 = j3 - j2 (현의 월드 피치 차). 접힘각 0° = 현 일직선 = 특이점.
   env_fold_max = -15°: 최대 신장에서도 |sin(접힘각)| ≥ 0.26 — 특이점 가드.
   env_fold_min = -132°: 깊은 접힘 간섭 한계 — check=2 실측 (하완 측판 ↔ 상완
   스탠드오프(160,-16): -135 통과 / -140 충돌, 여유 3°) */
env_fold_min = -132;
env_fold_max = -15;
env_j1 = 90;          // J1 요 ±90° [잠정 — 베이스 스탠드오프 회피 확인 항목]
env_j2_min = 0;       // J2 피치 하한 (수평) [잠정]
env_j2_max = 75;      // J2 피치 상한 [잠정]

/* ===== 모터 (motor) — CON-004: 산요덴키 SF24 시리즈 (NEMA 17 호환 42각) ===== */
motor_frame = 42;             // 프레임 폭 (mm)
nema17_hole_pitch = 31;       // 고정 볼트 피치
nema17_pilot_d = 22;          // 센터 파일럿 직경
nema17_bolt_d = 3;            // M3

/* ===== 감속비 (gear ratio) — CON-005: 5/10/20만 허용 ===== */
ratio_J1 = 20;   // SF2422 + MG17-G20 (요 — 중력 무부하, 관성 위주)
ratio_J2 = 20;   // SF2424 + MG17-G20 (최대 중력 토크 관절)
ratio_J3 = 20;   // SF2423 + MG17-G20 (크랭크 원격 구동)

/* ===== 기어박스 (gearbox) — MG17 ===== */
gbx_frame = 42;            // NEMA 17 플랜지, 모터와 동일 42각
gbx_len_20to1 = 51;        // MG17-G20 길이 (전 관절 공통)
gbx_out_shaft_d = 8;       // 출력축 직경
gbx_out_shaft_len = 20;    // 출력축 돌출 길이
gbx_in_insert = 9.5;       // 입력 결합 깊이 — SF24 축 길이 호환 확인 항목
gbx_mass_20to1 = 400;      // g — 질량 예산 계산용

/* ===== 모터 몸체 치수 — SF24 카탈로그 일반값 [잠정: 구매 데이터시트로 확인] ===== */
motor_len_SF2422 = 33;    // J1
motor_len_SF2423 = 39;    // J3
motor_len_SF2424 = 47;    // J2
motor_shaft_d = 5;        // SF24 출력축 (MG17 입력 클램프 ⌀5)

/* ===== 기성 플랜지 커플러 (flange coupler) — 축 직결 방식 =====
   기어박스 ⌀8 출력축을 무두 볼트(set screw)로 grip, 플랜지를 구동 부품에 볼트온.
   분할 클램프(슬릿+M3 핀치) 대체 — 전 관절 동일 (J1 허브/J2 허브/J3 크랭크).
   커플러는 갭(타워 내면 ↔ 구동 부품) 안에 수납, 운동 스윕 밖.
   치수 = 실제 부품(AliExpress '⌀8 flange coupling') 카탈로그:
     보어 ⌀8, 몸체 ⌀24 ×h13, 플랜지 ⌀50 ×t4.5, 볼트 서클 ⌀37 M5 ×4(90°),
     무두 볼트 M5 ×2(90°). 전고 17.5.
   주의: ⌀8 set-screw grip — J2 출력 토크 ≈ 11N·m엔 슬립 여유 부족 가능,
   D컷 축이면 평면 매칭 set screw 권장 (토크 재검 항목) */
cpl_bore = gbx_out_shaft_d;  // 8 = 기어박스 출력축
cpl_flange_od = 50;       // 플랜지 외경 (이미지)
cpl_flange_t = 4.5;       // 플랜지 두께 (이미지)
cpl_body_od = 24;         // 몸체 외경 (이미지)
cpl_body_h = 13;          // 플랜지 위 몸체 높이 (이미지)
cpl_h = cpl_flange_t + cpl_body_h;   // 17.5 전고
cpl_bolt_r = 18.5;        // 플랜지 볼트 서클 반경 (⌀37, 이미지)
cpl_bolt_n = 4;           // M5 ×4 (90°)
cpl_bolt_d = 5;           // M5 플랜지 볼트
cpl_set_d = 5;            // M5 무두 볼트 (set screw) ×2
cpl_set_n = 2;

/* ===== 공통 셀프태핑 파일럿 ===== */
set_screw_pilot_d = 3.4;  // M4 셀프태핑 파일럿

/* ===== 암 단면/관절 — 순수 플레이트 아키텍처 (v0.15~) =====
   원칙: ① 출력물은 평판(plate) + 소형 볼트온 — 간격은 육각 스탠드오프가 결정
        ② 동일 측판 ×2: 전 홀 관통(카운터보어 없음) → 평행이동 장착 (플립 불요)
          — 꺾임 빔에서도 성립 (꺾임면 = 피치 운동면, 측판 실루엣 동일)
        ③ 경량 관통창 금지 — hull 충전 단면 (꺾임 무릎 포함) */
arm_plate_t = 7;          // 측판 두께 = 608ZZ/6805ZZ 폭 (인-플레이트 압입)
hex_standoff_af = 13;     // 육각 스탠드오프 평면폭 (M6 암-암)
joint_spacer_od = 12;     // 관절 스택 스페이서 튜브 외경 (숄더 ⌀8 위)
arm_lug_r = 26;           // 관절 러그(피벗 보스) 반경

forearm_inner_w = 30;     // 하완 포크 내폭 (= 스탠드오프 L30)
arm_standoff_z = -16;     // 상완 스탠드오프 z (현 아래 벨트 — 링크 코리도 회피)

/* ===== J3 원격 구동 링키지 (크랭크-링크-혼 평행사변형) — 링크 = forearm 중앙 =====
   평행사변형 평면 = forearm 중앙면(y=0). 링크는 forearm 양 측판(±15) 사이
   중앙 채널을 주행 (외관상 forearm 중심). 크랭크는 J2축 중앙 근처 디스크 +
   긴 보스(+Y 측판 6805ZZ 통과 → 타워측 커플러까지 캔틸레버 연장)로 구동.
   혼은 forearm 양 측판을 잇는 크로스바 — 중앙 핀이 링크에 결합.
   크랭크 핀·혼 핀 모두 y≈0 (링크 평면) → 측판 관통/아크 슬롯 불요. */
crank_R = 36.5;           // 크랭크 핀 = 혼 핀 반경 (동일 → 평행사변형)
horn_phase = 155;         // 핀 위상 δ (하완 현 기준, deg)
link_w = 16;              // 링크 바 폭 (625ZZ 외경과 동일)
link_end_d = 22;          // 링크 양단 보스 외경 (625ZZ 압입 + 벽)
crank_boss_od = 25;       // 크랭크 보스 외경 (+Y 6805ZZ 내경 안착, CON-003)
crank_boss_id = 12;       // 보스 내경 (기어박스 축 ⌀8 도피)
crank_hub_d = 52;         // 크랭크 디스크 외경 (커플러 플랜지 ⌀50 수용)
crank_clear = 0.5;        // 런닝 간극

// y-좌표 (J2 프레임): 링크 중앙(y=0), 크랭크 +Y 플랭크, 혼 핀 -Y측에서 도달
link_y0    = -arm_plate_t / 2;                // -3.5 링크 -Y면
link_y1    =  arm_plate_t / 2;                //  3.5 링크 +Y면 (중앙 t7)
crank_y0   = link_y1 + washer_t;              //  4.7 크랭크 디스크 -Y(링크측)
crank_y1   = crank_y0 + arm_plate_t;          // 11.7 크랭크 디스크 +Y

arm_inner_w = 60;         // 상완 포크 내폭 — 크랭크 ⌀52 swing + forearm ±22 수용
ua_in_y    = arm_inner_w / 2;                 // 30 상완 측판 내면 (+Y 6805 in-plate)
ua_out_y   = ua_in_y + arm_plate_t;           // 37
crank_boss_len = ua_out_y + crank_clear - crank_y1;  // 25.8 보스: 디스크+Y(11.7)→측판외+간극(37.5)
crank_ofl_t = arm_plate_t;                    // 7 보스 외단 커플러 결합 플랜지(⌀52)
// 타워 갭(+Y): 크랭크 외단 플랜지(37.5~44.5)에 커플러 결합 — 측판과 0.5 런닝 간극
tower_in_pos = ua_out_y + crank_clear + crank_ofl_t + cpl_h + 0.5;  // 37.5+7+17.5+0.5=62.5
tower_in_neg = ua_out_y + arm_plate_t + cpl_h + 0.5;               // 37+7+17.5+0.5=62
tower_span = tower_in_neg + tower_in_pos;                          // 124.5 = 스탠드오프 L124.5

/* ===== 팔꿈치 (passive pivot) + 혼 핀 (forearm 측판 일체) =====
   피벗: 숄더 ⌀8×30 ×2 (하완에 너트 고정, 상완 측판 608ZZ 위 회전).
   ±Y 갭(8): 스페이서 튜브 ⌀12×8 ×2 (상완 608 내륜 ↔ 하완 측판).
   혼 = forearm 양 측판 사이 ⌀5 숄더 핀(R36.5, horn_phase) — 별도 부품 없음.
   핀이 파行사변형 힘을 양 측판에 전달(대칭, 무캔틸레버). 링크 625ZZ는 중앙(y0),
   양측 스페이서 튜브 ⌀8×12.5가 위치 결정. */
elbow_gap = (arm_inner_w - forearm_inner_w) / 2 - arm_plate_t;  // = 8
horn_pin_spacer = (forearm_inner_w - BRG_625ZZ[2]) / 2;  // 12.5 링크↔측판 스페이서 길이
elbow_ls_x = 45;          // J3 리미트 스위치: 팔꿈치에서 J2 방향 거리 (상완 +Y 내면)
elbow_vane_r = 48;        // J3 리미트 베인 반경 (forearm 측판 일체 탭)
elbow_vane_w = 8;         // 베인 탭 폭
elbow_vane_a = 320;       // 베인 위상 (forearm 로컬) [잠정]

/* ===== J2 허브 (⌀56) — 상완 -Y 측판 구동 =====
   측판 J2 보어 = 6805ZZ 압입(⌀37) → 허브 볼트 서클은 보어 밖 r24 */
hub_d_j2 = 56;            // J2 허브 디스크 외경
hub_bolt_r_j2 = 24;       // J2 허브 M4 FHCS ×3 서클 반경
j2_vane_r = 47;           // J2 리미트 베인 반경 (허브 일체 탭) — 타워 스탠드오프
                          //   스윕 내측 한계 48.4 (r55.9 - AF13/2) 미만 [check=5 실측]
j2_vane_a = 200;          // 베인 위상 (허브 로컬) [잠정]

/* ===== J1 베이스/터릿 (z: 베이스 플레이트 상면 = 0) ===== */
base_size = 200;          // 베이스 플레이트 정사각 한 변
base_corner_off = 85;     // 스탠드오프 코너 오프셋 (±85,±85 → r120, 터릿 스윕 밖)
base_lift = 115;          // 지면판 ↔ 베이스판 간격 = 스탠드오프 L115
                          //   (J1 액추에이터 매달림 91 + 커플러 10 + 여유)
// J1 = 6810 회전 내륜 방식: 링(고정)이 6810 외륜 압입, 터릿(회전) 보스가 내륜.
//   모멘트: 암→터릿→보스→6810 내륜→볼→외륜→링→베이스. 토크: 축→커플러→터릿 보스.
//   (구 ⌀41 허브가 6810 보어 공극에 볼트되던 결함 + ⌀50 커플러 비수용 해소)
j1_ring_h = 20;           // 링 전고 (6810 = 상부 z13~20)
j1_ring_bore = BRG_6810ZZ[1] + bearing_press_fit;  // ⌀64.85 6810 외륜 압입 (z13~20)
j1_ring_inner = 51;       // 시트 아래 내경 (회전 터릿 보스 ⌀50·커플러 ⌀50 클리어)
j1_ring_od = 78;          // 링 외경 (외륜 65 + 벽)
j1_ring_flange_od = 90;   // 링 바닥 플랜지 외경
j1_ring_bolt_r = 39;      // 플랜지 M4 ×4 서클 반경 (외륜 밖)
j1_boss_d = BRG_6810ZZ[0] - bearing_press_fit;     // ⌀50.15 터릿 보스 = 6810 내륜
hub_d_j1 = 41;            // [유산: drive_hub("j1") 정의용 — J1은 터릿 보스로 대체]
turret_t = 7;             // 터릿 플레이트 두께
turret_boss_h = BRG_6810ZZ[2];      // 7 — 터릿 보스 높이 (6810 폭, z13~20)
